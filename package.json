{
  "name": "tuition-backend",
  "version": "1.0.0",
  "description": "Backend API for Tuition Marketplace Platform",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "dev:ts": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node server.js",
    "start:ts": "node dist/index.js",
    "test": "jest",
    "seed-demo": "node dist/scripts/seedDemoAccounts.js",
    "seed-demo:dev": "ts-node src/scripts/seedDemoAccounts.ts",
    "seed-demo:force": "node dist/scripts/seedDemoAccounts.js --force",
    "test:watch": "jest --watch",
    "backfill-geo": "node dist/scripts/backfillGeoPoints.js",
    "backfill-geo:apply": "node dist/scripts/backfillGeoPoints.js --apply"
  },
  "keywords": [
    "tuition",
    "marketplace",
    "education",
    "tutor",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/lib-storage": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
